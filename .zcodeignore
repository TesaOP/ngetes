# dependencies
node_modules/

# build output — static/js/app.js (driver karakter) TETAP di-track (parity
# guard); bundle + i18n + live2d-view adalah hasil build dari src/ (bun run build)
dist/
static/js/bundle.js
static/js/i18n.js
static/js/live2d-view.mjs

# Cubism Core = proprietary Live2D ("Redistributable Code") — lisensinya
# melarang Core dipublish berdiri sendiri di repo publik. Diunduh terpisah:
# bun run setup:core (CDN resmi Live2D)
static/js/live2dcubismcore.min.js

# data user & aset berlisensi — tidak pernah masuk repo (privasi + lisensi;
# lihat README "Data user"). Dulu piecemeal, _param_todo.json lolos — kini utuh.
data/

# model inferensi yang diunduh on-demand (Whisper ggml-*.bin, cache SuperTonic
# di ~/.cache) — runtime data, bukan source.
engines/models/

# state runtime agent (ingatan tool remember — lokal saja)
.agent-memory/

# state CLI lokal (rencana sesi, artifact)
.zcode/

# Rust workspace — build artifacts only; sources & Cargo.lock di-track.
# Target terpusat di root (workspace).
/target/

# lain-lain
*.tmp
*.log
.DS_Store

# ===== ↑ 以上同步自 .gitignore（「从 .gitignore 同步」只重写以上部分）=====
.git/
.hg/
.svn/
bower_components/
jspm_packages/
__pycache__/
site-packages/
venv/
coverage/
htmlcov/
lcov-report/
cmakefiles/
cmake-build-*/
bazel-*/
pods/
deriveddata/
storybook-static/
playwright-report/
test-results/
allure-results/
allure-report/
cdk.out/
*.egg-info/
*.dist-info/
eggs/
pip-wheel-metadata/
wheels/
